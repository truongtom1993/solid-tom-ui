{
  "name": "solid-tom-ui",
  "version": "2.1.1",
  "description": "SolidJS UI component library (Ant Design–inspired, Tailwind CSS + DaisyUI)",
  "homepage": "https://solid-tom-ui.netlify.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/truongtom1993/solid-tom-ui.git"
  },
  "author": "Truong Tom",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "solidjs",
    "ui",
    "components",
    "tailwindcss",
    "daisyui",
    "ant-design"
  ],
  "exports": {
    ".": {
      "import": "./lib.js",
      "types": "./lib.d.ts"
    },
    "./styles": "./solid-ui.css"
  },
  "main": "./lib.js",
  "module": "./lib.js",
  "types": "./lib.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@tanstack/solid-table": "~8.21.3",
    "@tanstack/solid-virtual": "~3.13.37",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "imask": "~7.6.1",
    "lucide-solid": "~0.469.0",
    "qrcode": "~1.5.4",
    "solid-js": "~1.9.15",
    "tailwind-merge": "~3.6.0"
  }
}
